### Register user 1 (becomes Owner)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "Owner",
  "email": "owner@test.com",
  "password": "Test123!"
}

### Register user 2 (will be invited)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "Developer1",
  "email": "dev@test.com",
  "password": "Test123!"
}

### Login as Owner
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@test.com",
  "password": "Test123!"
}

### Login as Developer1
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "dev@test.com",
  "password": "Test123!"
}

### Create project (Owner)
POST {{baseUrl}}/api/project
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Test Project",
  "description": "Ett testprojekt"
}

### Get projects (Owner — should see the project)
GET {{baseUrl}}/api/project
Authorization: Bearer {{ownerToken}}

### Get projects (Developer1 — should see nothing yet)
GET {{baseUrl}}/api/project
Authorization: Bearer {{userToken}}

### Search users by username
GET {{baseUrl}}/api/user/search?username=dev
Authorization: Bearer {{ownerToken}}

### Send invitation (Owner invites Developer1, use id from search result)
POST {{baseUrl}}/api/invitation
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "projectId": 19,
  "invitedUserId": 13,
  "role": "Developer"
}

### Get pending invitations (Developer1)
GET {{baseUrl}}/api/invitation/pending
Authorization: Bearer {{userToken}}

### Accept invitation (Developer1, use id from pending result)
PUT {{baseUrl}}/api/invitation/1/accept
Authorization: Bearer {{userToken}}

### Get projects (Developer1 — should now see the project)
GET {{baseUrl}}/api/project
Authorization: Bearer {{userToken}}

### Create issue (requires token)
POST {{baseUrl}}/api/issue
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "projectId": 1,
  "title": "Test issue",
  "description": "En testissue",
  "priority": "Low"
}

### Get all issues for project
GET {{baseUrl}}/api/issue?projectId=1
Authorization: Bearer {{ownerToken}}

### Get issue by id
GET {{baseUrl}}/api/issue/1
Authorization: Bearer {{ownerToken}}

### Update issue
PUT {{baseUrl}}/api/issue/1
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "status": "InProgress"
}

### Delete issue
DELETE {{baseUrl}}/api/issue/1
Authorization: Bearer {{ownerToken}}

### Get comments by issueId
GET {{baseUrl}}/api/comment?issueId=1
Authorization: Bearer {{ownerToken}}

### Create comment
POST {{baseUrl}}/api/comment
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "issueId": 1,
  "content": "En testkommentar"
}

### Update comment
PUT {{baseUrl}}/api/comment/1
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "content": "Uppdaterad kommentar"
}

### Delete comment
DELETE {{baseUrl}}/api/comment/1
Authorization: Bearer {{ownerToken}}

### Delete project (Owner only)
DELETE {{baseUrl}}/api/project/1
Authorization: Bearer {{ownerToken}}